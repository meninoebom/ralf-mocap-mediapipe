{
  "name": "ralf-mocap-mediapipe",
  "version": "0.1.0",
  "description": "Motion capture CLI using MediaPipe Pose and OSC",
  "type": "module",
  "bin": {
    "mocap": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js start",
    "dev": "nodemon --exec 'node bin/cli.js start'",
    "dev:debug": "nodemon --exec 'node bin/cli.js start --debug'",
    "dev:upper": "nodemon --exec 'node bin/cli.js start --upper-body --debug'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "open": "^10.1.0",
    "osc-min": "^1.1.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "vitest": "^2.1.9"
  }
}
